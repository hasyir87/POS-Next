
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserOrgId() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.organization_id;
    }

    // --- COLLECTION: profiles ---
    // Users can read/update their own profile.
    match /profiles/{userId} {
      allow read, update: if isUserAuthenticated() && request.auth.uid == userId;
      // Allow creation during signup process.
      allow create: if isUserAuthenticated();
    }

    // --- COLLECTION: organizations ---
    // Users can read organizations that are either their main one or a sub-outlet.
    match /organizations/{orgId} {
      allow read: if isUserAuthenticated() && 
                   (getUserOrgId() == orgId || resource.data.parent_organization_id == getUserOrgId());
      // Only owners can create/update outlets (handled by Cloud Functions).
      allow write: if false; 
    }

    // --- GENERIC RULE FOR TENANT DATA ---
    // This rule applies to products, customers, transactions, raw_materials, etc.
    match /{collection}/{docId} {
      // READ, UPDATE, DELETE: Allow if the document's org_id matches the user's org_id.
      allow read, update, delete: if isUserAuthenticated() && resource.data.organization_id == getUserOrgId();
      
      // CREATE: Allow if the new document's org_id matches the user's org_id.
      allow create: if isUserAuthenticated() && request.resource.data.organization_id == getUserOrgId();
      
      // LIST (QUERY): This is the critical fix.
      // Enforce that any query on the collection MUST be filtered by the user's organization_id.
      allow list: if isUserAuthenticated() && request.query.get("organization_id") == getUserOrgId();
    }
  }
}
