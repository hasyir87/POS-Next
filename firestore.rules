rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi untuk memeriksa apakah pengguna adalah bagian dari organisasi
    function isUserInOrg(orgId) {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.organization_id == orgId;
    }

    // Izinkan pemilik organisasi untuk membaca data organisasi mereka
    match /organizations/{orgId} {
      allow read: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow write: if request.auth != null && resource.data.owner_id == request.auth.uid;
    }

    // Izinkan pengguna membaca profil mereka sendiri
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Aturan umum untuk koleksi lain yang memiliki organization_id
    // Ini berlaku untuk: products, raw_materials, customers, transactions, grades,
    // expenses, payables, receivables, shifts.
    match /{collection}/{docId} {
      allow read, write, create, delete: if request.auth != null && isUserInOrg(request.resource.data.organization_id);
      allow list: if request.auth != null && isUserInOrg(request.query.organization_id);
    }
  }
}
