rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function userOrgId() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.organization_id;
    }

    function userRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }
    
    function isUserInOrg(orgId) {
      return userOrgId() == orgId;
    }

    function isOwner(orgId) {
        return request.auth.uid == get(/databases/$(database)/documents/organizations/$(orgId)).data.owner_id;
    }
    
    function isSuperAdmin() {
        return userRole() == 'superadmin';
    }

    // --- Collection Rules ---

    // Profiles: Users can read/update their own profile.
    match /profiles/{userId} {
      allow read, update: if request.auth.uid == userId;
      // allow create: Needed for signup, handled by backend functions.
    }

    // Organizations: Users can read organizations they belong to.
    match /organizations/{orgId} {
      allow read: if isUserInOrg(orgId) || isOwner(orgId) || isSuperAdmin();
      allow list: if isSuperAdmin() || (request.query.get("owner_id") == request.auth.uid) || (request.query.get("parent_organization_id") == userOrgId());
      allow update: if isOwner(orgId) || isSuperAdmin();
      allow create: if request.auth.uid == request.resource.data.owner_id;
    }

    // Products: Can be managed by members of the organization.
    match /products/{productId} {
      allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
      allow create: if isUserInOrg(request.resource.data.organization_id);
    }
    
    // Raw Materials: Can be managed by members of the organization.
    match /raw_materials/{materialId} {
       allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
       allow create: if isUserInOrg(request.resource.data.organization_id);
    }

    // Customers: Can be managed by members of the organization.
    match /customers/{customerId} {
      allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
      allow create: if isUserInOrg(request.resource.data.organization_id);
    }

    // Transactions: Can be created and read by members.
    match /transactions/{transactionId} {
      allow read, list: if isUserInOrg(resource.data.organization_id);
      allow create: if isUserInOrg(request.resource.data.organization_id);
    }

    // Grades: Can be managed by members of the organization.
    match /grades/{gradeId} {
      allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
      allow create: if isUserInOrg(request.resource.data.organization_id);
    }

    // Expenses: Can be managed by members of the organization.
    match /expenses/{expenseId} {
      allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
      allow create: if isUserInOrg(request.resource.data.organization_id);
    }
    
    // Shifts: Can be managed by members of the organization.
    match /shifts/{shiftId} {
      allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
      allow create: if isUserInOrg(request.resource.data.organization_id);
    }
    
    // Payables & Receivables: Can be managed by members.
    match /payables/{payableId} {
        allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
        allow create: if isUserInOrg(request.resource.data.organization_id);
    }
     match /receivables/{receivableId} {
        allow read, list, update, delete: if isUserInOrg(resource.data.organization_id);
        allow create: if isUserInOrg(request.resource.data.organization_id);
    }
  }
}